<script>
(function(){
  const stages = [...document.querySelectorAll('.panel')];
  const dotsWrap = document.getElementById('stageDots');
  const railFill = document.getElementById('railFill');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const stepLabel = document.getElementById('stepLabel');

  stages.forEach((s, i) => {
    const b = document.createElement('button');
    b.setAttribute('aria-label', 'Go to step ' + (i + 1));
    b.addEventListener('click', () => showStep(i));
    dotsWrap.appendChild(b);
  });
  const dotButtons = [...dotsWrap.children];

  let currentIndex = 0;

  function animateBars(panel){
    panel.querySelectorAll('.bar-fill').forEach(el => {
      const target = el.getAttribute('data-target');
      requestAnimationFrame(() => { el.style.width = target + '%'; });
    });
    panel.querySelectorAll('.bar-value').forEach(el => {
      const target = parseInt(el.getAttribute('data-target'), 10);
      const duration = 700;
      const start = performance.now();
      function tick(now){
        const progress = Math.min(1, (now - start) / duration);
        el.textContent = Math.round(target * progress);
        if (progress < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    });
  }

  function showStep(i){
    currentIndex = Math.max(0, Math.min(stages.length - 1, i));
    stages.forEach((s, idx) => { s.style.display = (idx === currentIndex) ? 'block' : 'none'; });
    window.scrollTo({top: 0, behavior: 'auto'});
    updateNav();
    animateBars(stages[currentIndex]);
  }

  function updateNav(){
    prevBtn.disabled = currentIndex === 0;
    nextBtn.disabled = currentIndex === stages.length - 1;
    const isLast = currentIndex === stages.length - 1;
    nextBtn.querySelector('.full').textContent = isLast ? 'Done' : 'Next';
    nextBtn.lastChild.textContent = isLast ? '' : ' →';
    nextBtn.setAttribute('aria-label', isLast ? 'Done — this is the last step' : 'Next step');
    stepLabel.textContent = `Step ${currentIndex + 1} of ${stages.length}`;
    railFill.style.width = (currentIndex / (stages.length - 1)) * 100 + '%';
    dotButtons.forEach((b, i) => b.setAttribute('aria-current', String(i === currentIndex)));
  }

  prevBtn.addEventListener('click', () => showStep(currentIndex - 1));
  nextBtn.addEventListener('click', () => showStep(currentIndex + 1));
  document.getElementById('startBtn').addEventListener('click', () => showStep(1));
  showStep(0);
})();
</script>

